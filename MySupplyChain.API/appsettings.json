{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=MySupplyChainDb;Trusted_Connection=True;MultipleActiveResultSets=true"
    },
    "JwtSettings": {
        "Secret": "YOUR_SECRET_KEY_HERE_DO_NOT_COMMIT",
        "Issuer": "MySupplyChain.API",
        "Audience": "MySupplyChain.Client",
        "ExpiryMinutes": 60
    }
}